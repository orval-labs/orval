    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "catalog:ts6",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@orval/angular": "workspace:*",
    "@orval/axios": "workspace:*",
    "@orval/effect": "workspace:*",
    "@orval/fetch": "workspace:*",
