    "execa": "^9.6.1",
    "get-tsconfig": "^4.14.3",
    "jiti": "^2.6.1",
    "js-yaml": "4.3.2",
    "json5": "2.2.3",
    "string-argv": "^0.3.2"
  },
  "devDependencies": {
