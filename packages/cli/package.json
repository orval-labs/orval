  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orval-labs/orval.git",
    "directory": "packages/cli"
  },
  "bin": {
    "orval": "./dist/bin/orval.mjs"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.d.mts.map"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./bin/orval": "./dist/bin/orval.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
