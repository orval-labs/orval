{
  "name": "@orval/cli",
  "version": "8.49.0",
  "description": "Composable Orval CLI and programmatic API",
  "keywords": [
    "cli",
    "code-generation",
    "openapi",
    "typescript"
  ],
  "homepage": "https://orval.dev",
  "bugs": {
    "url": "https://github.com/orval-labs/orval/issues"
