{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    // The SDK nests its own Zod. Point both imports at this sample's copy so
    // generated schemas stay assignable to the SDK's schema types.
    "paths": {
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"]
    }
  },
  "include": ["src/**/*.ts", "*.ts"],
  "exclude": [
    "node_modules",
    "__snapshots__",
    "api-generation.spec.ts",
    "vitest.snapshots.ts",
    "orval.config.ts",
    "orval.config.js"
  ]
}
