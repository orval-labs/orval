{
  "name": "svelte-query-basic",
  "version": "8.50.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "prepare": "svelte-kit sync",
    "preview": "vp preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate-api": "svelte-kit sync && vp exec orval",
    "test:snapshots": "vp test run --config vitest.snapshots.ts",
    "test:snapshots:update": "vp run test:snapshots --update",
    "test": "vp run check"
  },
  "scriptsComments": {
    "prepare": "see https://github.com/sveltejs/kit/issues/5390#issuecomment-1176480653"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:tooling",
    "@sveltejs/adapter-auto": "^2.1.1",
    "@sveltejs/kit": "^1.30.4",
    "@types/node": "catalog:",
    "msw": "catalog:tooling",
    "orval": "workspace:*",
    "prettier": "catalog:",
    "svelte": "catalog:svelte",
    "svelte-check": "catalog:svelte",
    "tslib": "catalog:",
    "typescript": "catalog:ts6",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "@tanstack/svelte-query": "catalog:svelte",
    "axios": "catalog:axios"
  },
  "dependenciesMeta": {
    "msw": {
      "built": true
    }
  },
  "msw": {
    "workerDirectory": "static"
  }
}
