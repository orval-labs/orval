{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "noUnusedLocals": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false
  },
  "include": ["*.ts", "**/*.ts"],
  "exclude": ["node_modules", "__snapshots__", "*.spec.ts", "*.test.ts"]
}
